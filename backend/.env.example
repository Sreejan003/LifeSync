# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL connection string for Render, Railway, Neon, Supabase)
# If left empty in local development, the backend automatically uses a local zero-config SQLite database (lifesync.db)
DATABASE_URL=

# Security
JWT_SECRET=your_jwt_secret_here

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:5000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_PROJECT_ID=your_google_project_id_here
