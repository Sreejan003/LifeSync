# =================================================================
# LifeSync Environment Configuration Template
# =================================================================

# Server & Runtime Environment
PORT=5000
NODE_ENV=production

# Database Connection (Supabase PostgreSQL or any PostgreSQL provider)
# Format (Supabase Session Pooler - Recommended for serverless/cloud containers):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Format (Supabase Direct Connection):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# NOTE: If DATABASE_URL is left empty, LifeSync automatically runs on a local zero-config SQLite database (lifesync.db)
DATABASE_URL=

# Supabase Project Credentials (Optional - for direct Supabase Auth or Storage integrations)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Authentication & Security
# Generate a strong 64-character secret in production using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=lifesync_super_secret_jwt_key_2026_student_prod_change_me

# Allowed Frontend Client Origin (for CORS)
# In production on Render/Railway/Vercel, set to your production frontend domain (e.g., https://lifesync.onrender.com)
CLIENT_URL=http://localhost:5000

# Web Push API (VAPID Keys for Closed-Browser Notifications)
# Generate via: node backend/scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=BGZ2QUl6ZcWXQswnjZaz8Vu8DymQVR6W64vex9yMgbELW12AQ_76hkx6PJsCY_kPQ2GcENYXAsPy058g54TYfyA
VAPID_PRIVATE_KEY=PujCkI9mXMTztekyPODLa69cWGGrppFk806i0qOOsn4
VAPID_SUBJECT=mailto:notifications@lifesync.edu
